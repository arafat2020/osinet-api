# ── Application ──────────────────────────────────────────────
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/osint
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── OSINT Execution ──────────────────────────────────────────
REQUEST_TIMEOUT=30
MAX_CONCURRENT_PROVIDERS=5

# ── Feature Flags ────────────────────────────────────────────
# Toggle features on/off without code changes
ENABLE_AUTH=false
ENABLE_RATE_LIMITING=false
ENABLE_BACKGROUND_WORKERS=false
ENABLE_DATABASE=false

# ── Authentication (only used when ENABLE_AUTH=true) ─────────
# Comma-separated list of valid API keys
API_KEYS=["your-api-key-here"]
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256

# ── Rate Limiting (only used when ENABLE_RATE_LIMITING=true) ─
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ── PhoneInfoga ──────────────────────────────────────────────
PHONEINFOGA_URL=http://localhost:5000
